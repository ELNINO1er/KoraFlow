// KoraFlow — Schéma Prisma
// Sprint 1.2 : socle multi-tenant (User, Organization, Membership, Invitation, AuditLog).
// Conventions transverses :
//   - Toute donnée métier appartenant à une entreprise porte `organizationId`.
//   - Montants stockés en ENTIERS (plus petite unité de la devise) + code ISO 4217.
//   - Horodatage en UTC (Prisma stocke les DateTime en UTC).
//   - Identifiants en cuid().
//   - Rôles = enum ; la matrice de permissions vit dans le code serveur (typée, testée).
// NB : les tables d'authentification propres à Better Auth (session, account,
//      verification) seront ajoutées au sprint 1.3 via l'outil officiel Better Auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // En Prisma 7, l'URL de connexion vit dans prisma.config.ts (Migrate/CLI) et
  // le PrismaClient runtime utilise un driver adapter (voir src/server/database/client.ts).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rôles d'un membre au sein d'une organisation (voir matrice §11).

enum MembershipRole {
  OWNER // propriétaire
  ADMIN // administrateur
  SALES // commercial
  PROJECT_MANAGER // chef de projet
  ACCOUNTANT // comptable
  COLLABORATOR // collaborateur
  CLIENT // client (acteur externe restreint au portail)
}

/// Cycle de vie d'une invitation de membre.

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Utilisateur (compte global, indépendant de l'organisation)
// Format aligné sur les attentes de Better Auth (email, emailVerified, image).
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships       Membership[]
  sentInvitations   Invitation[]      @relation("InvitationInviter")
  auditLogs         AuditLog[]
  ownedContacts     Contact[]         @relation("ContactOwner")
  contactActivities ContactActivity[] @relation("ContactActivityActor")
  createdQuotes     Quote[]           @relation("QuoteCreatedBy")

  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]

  @@map("user")
}

// ---------------------------------------------------------------------------
// Organisation (tenant) — profil enrichi (identité, fiscalité, préférences)
// ---------------------------------------------------------------------------

model Organization {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  legalName String?
  logoUrl   String?

  // Coordonnées
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  country      String  @default("CI") // ISO 3166-1 alpha-2

  // Préférences internationalisation / facturation
  currency String @default("XOF") // ISO 4217
  timezone String @default("Africa/Abidjan")
  locale   String @default("fr")

  // Informations fiscales / facturation
  taxId         String? // identifiant fiscal (ex. NCC en CI)
  taxRegime     String?
  invoicePrefix String  @default("FAC")
  quotePrefix   String  @default("DEV")

  // Personnalisation simple de la marque
  brandColor String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // suppression logique

  memberships       Membership[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  contacts          Contact[]
  contactActivities ContactActivity[]
  services          Service[]
  quotes            Quote[]
  quoteItems        QuoteItem[]

  @@index([deletedAt])
  @@map("organization")
}

// ---------------------------------------------------------------------------
// Membership — appartenance User × Organization + rôle
// ---------------------------------------------------------------------------

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(COLLABORATOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // un utilisateur = un seul rôle par organisation
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Invitation — jeton d'invitation d'un membre dans une organisation
// ---------------------------------------------------------------------------

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(COLLABORATOR)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  invitedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  // une invitation active par e-mail et organisation
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// AuditLog — journal des opérations sensibles (§9, §10, §17)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String // ex. "invitation.created", "membership.role_changed"
  targetType     String? // ex. "Membership", "Organization"
  targetId       String?
  metadata       Json? // contexte non sensible uniquement
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_log")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ---------------------------------------------------------------------------
// CRM — Contacts (prospects & clients) et leur historique d'activités
// ---------------------------------------------------------------------------

/// Nature du contact.
enum ContactType {
  PROSPECT
  CLIENT
}

/// Étape du pipeline commercial (§5).
enum ContactStage {
  NEW_REQUEST // nouvelle demande
  TO_CONTACT // à contacter
  APPOINTMENT_SCHEDULED // rendez-vous planifié
  QUOTE_IN_PREPARATION // devis en préparation
  QUOTE_SENT // devis envoyé
  NEGOTIATION // négociation
  CONVERTED // converti
  LOST // perdu
}

/// Type d'entrée dans l'historique d'un contact.
enum ContactActivityType {
  CREATED
  NOTE
  STAGE_CHANGED
  CALL
  EMAIL
  TASK
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  type           ContactType  @default(PROSPECT)
  stage          ContactStage @default(NEW_REQUEST)

  firstName   String
  lastName    String?
  email       String?
  phone       String?
  companyName String?
  source      String? // origine du prospect (formulaire, référence, etc.)
  notes       String? // note interne rapide

  ownerId String? // responsable (membre de l'organisation)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // suppression logique

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?             @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities   ContactActivity[]
  quotes       Quote[]

  @@index([organizationId, stage])
  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@index([organizationId, ownerId])
  @@map("contact")
}

model ContactActivity {
  id             String              @id @default(cuid())
  organizationId String
  contactId      String
  type           ContactActivityType
  content        String?
  metadata       Json?
  actorUserId    String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ContactActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, contactId, createdAt])
  @@map("contact_activity")
}

// ---------------------------------------------------------------------------
// Catalogue de services (offres facturables par organisation)
// ---------------------------------------------------------------------------

model Service {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?

  /// Prix HORS TAXE, en entier, dans la plus petite unité de la devise de l'organisation.
  priceMinor               Int     @default(0)
  /// Unité de vente (ex. « heure », « jour », « forfait », « mois »).
  unit                     String  @default("forfait")
  category                 String?
  /// Taux de taxe en points de pourcentage (ex. 18 pour une TVA à 18 %).
  taxRate                  Int     @default(0)
  /// Durée estimée en minutes (optionnelle).
  estimatedDurationMinutes Int?

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems   QuoteItem[]

  @@index([organizationId, active])
  @@index([organizationId, category])
  @@map("service")
}

// ---------------------------------------------------------------------------
// Devis (Quote) et lignes de devis (QuoteItem)
// ---------------------------------------------------------------------------

/// Statuts d'un devis (§5).
enum QuoteStatus {
  DRAFT // brouillon
  SENT // envoyé
  VIEWED // consulté
  ACCEPTED // accepté
  REJECTED // refusé
  EXPIRED // expiré
  CANCELED // annulé
}

/// Mode de remise/acompte : pourcentage ou montant fixe.
enum AmountKind {
  PERCENT
  AMOUNT
}

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  contactId      String
  number         String // ex. DEV-2026-0001 (unique par organisation)
  status         QuoteStatus @default(DRAFT)
  currency       String // devise figée à la création

  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  notes      String?
  terms      String?

  // Remise globale
  discountType  AmountKind?
  discountValue Int         @default(0) // points de % ou montant (plus petite unité)

  // Acompte demandé
  depositType  AmountKind?
  depositValue Int         @default(0)

  // Totaux figés (plus petite unité de la devise) — recalculés à chaque écriture.
  subtotalMinor Int @default(0) // HT avant remise
  discountMinor Int @default(0)
  taxMinor      Int @default(0)
  totalMinor    Int @default(0) // TTC
  depositMinor  Int @default(0)

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        QuoteItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  @@map("quote")
}

model QuoteItem {
  id             String  @id @default(cuid())
  organizationId String
  quoteId        String
  serviceId      String? // lien optionnel vers le catalogue (snapshot des valeurs ci-dessous)

  description    String
  unitPriceMinor Int    @default(0) // prix unitaire HT
  quantity       Int    @default(1)
  taxRate        Int    @default(0) // %
  position       Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, quoteId])
  @@map("quote_item")
}
