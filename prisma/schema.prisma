// KoraFlow — Schéma Prisma
// Sprint 1.2 : socle multi-tenant (User, Organization, Membership, Invitation, AuditLog).
// Conventions transverses :
//   - Toute donnée métier appartenant à une entreprise porte `organizationId`.
//   - Montants stockés en ENTIERS (plus petite unité de la devise) + code ISO 4217.
//   - Horodatage en UTC (Prisma stocke les DateTime en UTC).
//   - Identifiants en cuid().
//   - Rôles = enum ; la matrice de permissions vit dans le code serveur (typée, testée).
// NB : les tables d'authentification propres à Better Auth (session, account,
//      verification) seront ajoutées au sprint 1.3 via l'outil officiel Better Auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // En Prisma 7, l'URL de connexion vit dans prisma.config.ts (Migrate/CLI) et
  // le PrismaClient runtime utilise un driver adapter (voir src/server/database/client.ts).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rôles d'un membre au sein d'une organisation (voir matrice §11).

enum MembershipRole {
  OWNER // propriétaire
  ADMIN // administrateur
  SALES // commercial
  PROJECT_MANAGER // chef de projet
  ACCOUNTANT // comptable
  COLLABORATOR // collaborateur
  CLIENT // client (acteur externe restreint au portail)
}

/// Cycle de vie d'une invitation de membre.

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Utilisateur (compte global, indépendant de l'organisation)
// Format aligné sur les attentes de Better Auth (email, emailVerified, image).
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships             Membership[]
  sentInvitations         Invitation[]      @relation("InvitationInviter")
  auditLogs               AuditLog[]
  ownedContacts           Contact[]         @relation("ContactOwner")
  contactActivities       ContactActivity[] @relation("ContactActivityActor")
  createdQuotes           Quote[]           @relation("QuoteCreatedBy")
  createdContracts        Contract[]        @relation("ContractCreatedBy")
  createdInvoices         Invoice[]         @relation("InvoiceCreatedBy")
  confirmedPayments       Payment[]         @relation("PaymentConfirmedBy")
  createdProjects         Project[]         @relation("ProjectCreatedBy")
  assignedTasks           Task[]            @relation("TaskAssignee")
  createdForms            Form[]            @relation("FormCreatedBy")
  createdAppointmentTypes AppointmentType[] @relation("AppointmentTypeCreatedBy")
  notifications           Notification[]

  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]

  @@map("user")
}

// ---------------------------------------------------------------------------
// Organisation (tenant) — profil enrichi (identité, fiscalité, préférences)
// ---------------------------------------------------------------------------

model Organization {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  legalName String?
  logoUrl   String?

  // Coordonnées
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  country      String  @default("CI") // ISO 3166-1 alpha-2

  // Préférences internationalisation / facturation
  currency String @default("XOF") // ISO 4217
  timezone String @default("Africa/Abidjan")
  locale   String @default("fr")

  // Informations fiscales / facturation
  taxId         String? // identifiant fiscal (ex. NCC en CI)
  taxRegime     String?
  invoicePrefix String  @default("FAC")
  quotePrefix   String  @default("DEV")

  // Personnalisation simple de la marque
  brandColor String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // suppression logique

  memberships       Membership[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  contacts          Contact[]
  contactActivities ContactActivity[]
  services          Service[]
  quotes            Quote[]
  quoteItems        QuoteItem[]
  contractTemplates ContractTemplate[]
  contracts         Contract[]
  signatureEvents   SignatureEvent[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
  payments          Payment[]
  projects          Project[]
  projectStages     ProjectStage[]
  tasks             Task[]
  forms             Form[]
  formFields        FormField[]
  formSubmissions   FormSubmission[]
  appointmentTypes  AppointmentType[]
  availabilities    Availability[]
  appointments      Appointment[]
  notifications     Notification[]

  @@index([deletedAt])
  @@map("organization")
}

// ---------------------------------------------------------------------------
// Membership — appartenance User × Organization + rôle
// ---------------------------------------------------------------------------

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(COLLABORATOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // un utilisateur = un seul rôle par organisation
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Invitation — jeton d'invitation d'un membre dans une organisation
// ---------------------------------------------------------------------------

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(COLLABORATOR)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  invitedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  // une invitation active par e-mail et organisation
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// AuditLog — journal des opérations sensibles (§9, §10, §17)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String // ex. "invitation.created", "membership.role_changed"
  targetType     String? // ex. "Membership", "Organization"
  targetId       String?
  metadata       Json? // contexte non sensible uniquement
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_log")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ---------------------------------------------------------------------------
// CRM — Contacts (prospects & clients) et leur historique d'activités
// ---------------------------------------------------------------------------

/// Nature du contact.
enum ContactType {
  PROSPECT
  CLIENT
}

/// Étape du pipeline commercial (§5).
enum ContactStage {
  NEW_REQUEST // nouvelle demande
  TO_CONTACT // à contacter
  APPOINTMENT_SCHEDULED // rendez-vous planifié
  QUOTE_IN_PREPARATION // devis en préparation
  QUOTE_SENT // devis envoyé
  NEGOTIATION // négociation
  CONVERTED // converti
  LOST // perdu
}

/// Type d'entrée dans l'historique d'un contact.
enum ContactActivityType {
  CREATED
  NOTE
  STAGE_CHANGED
  CALL
  EMAIL
  TASK
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  type           ContactType  @default(PROSPECT)
  stage          ContactStage @default(NEW_REQUEST)

  firstName   String
  lastName    String?
  email       String?
  phone       String?
  companyName String?
  source      String? // origine du prospect (formulaire, référence, etc.)
  notes       String? // note interne rapide
  portalToken String? @unique // jeton d'accès au portail client unifié

  ownerId String? // responsable (membre de l'organisation)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // suppression logique

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?             @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities      ContactActivity[]
  quotes          Quote[]
  contracts       Contract[]
  invoices        Invoice[]
  projects        Project[]
  formSubmissions FormSubmission[]
  appointments    Appointment[]

  @@index([organizationId, stage])
  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@index([organizationId, ownerId])
  @@map("contact")
}

model ContactActivity {
  id             String              @id @default(cuid())
  organizationId String
  contactId      String
  type           ContactActivityType
  content        String?
  metadata       Json?
  actorUserId    String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ContactActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, contactId, createdAt])
  @@map("contact_activity")
}

// ---------------------------------------------------------------------------
// Catalogue de services (offres facturables par organisation)
// ---------------------------------------------------------------------------

model Service {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?

  /// Prix HORS TAXE, en entier, dans la plus petite unité de la devise de l'organisation.
  priceMinor               Int     @default(0)
  /// Unité de vente (ex. « heure », « jour », « forfait », « mois »).
  unit                     String  @default("forfait")
  category                 String?
  /// Taux de taxe en points de pourcentage (ex. 18 pour une TVA à 18 %).
  taxRate                  Int     @default(0)
  /// Durée estimée en minutes (optionnelle).
  estimatedDurationMinutes Int?

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems   QuoteItem[]

  @@index([organizationId, active])
  @@index([organizationId, category])
  @@map("service")
}

// ---------------------------------------------------------------------------
// Devis (Quote) et lignes de devis (QuoteItem)
// ---------------------------------------------------------------------------

/// Statuts d'un devis (§5).
enum QuoteStatus {
  DRAFT // brouillon
  SENT // envoyé
  VIEWED // consulté
  ACCEPTED // accepté
  REJECTED // refusé
  EXPIRED // expiré
  CANCELED // annulé
}

/// Mode de remise/acompte : pourcentage ou montant fixe.
enum AmountKind {
  PERCENT
  AMOUNT
}

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  contactId      String
  number         String // ex. DEV-2026-0001 (unique par organisation)
  status         QuoteStatus @default(DRAFT)
  currency       String // devise figée à la création
  publicToken    String?     @unique // jeton secret pour la consultation publique

  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  notes      String?
  terms      String?

  // Remise globale
  discountType  AmountKind?
  discountValue Int         @default(0) // points de % ou montant (plus petite unité)

  // Acompte demandé
  depositType  AmountKind?
  depositValue Int         @default(0)

  // Totaux figés (plus petite unité de la devise) — recalculés à chaque écriture.
  subtotalMinor Int @default(0) // HT avant remise
  discountMinor Int @default(0)
  taxMinor      Int @default(0)
  totalMinor    Int @default(0) // TTC
  depositMinor  Int @default(0)

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  contracts    Contract[]
  invoices     Invoice[]
  projects     Project[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  @@map("quote")
}

model QuoteItem {
  id             String  @id @default(cuid())
  organizationId String
  quoteId        String
  serviceId      String? // lien optionnel vers le catalogue (snapshot des valeurs ci-dessous)

  description    String
  unitPriceMinor Int    @default(0) // prix unitaire HT
  quantity       Int    @default(1)
  taxRate        Int    @default(0) // %
  position       Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, quoteId])
  @@map("quote_item")
}

// ---------------------------------------------------------------------------
// Contrats : modèles, contrats générés, événements de signature
// ---------------------------------------------------------------------------

enum ContractStatus {
  DRAFT // brouillon
  SENT // envoyé pour signature
  SIGNED // signé
  CANCELED // annulé
}

enum SignatureEventType {
  VIEWED
  CONSENT
  SIGNED
}

model ContractTemplate {
  id             String @id @default(cuid())
  organizationId String
  name           String
  /// Corps du modèle, avec variables {{client_name}}, {{quote_number}}, etc.
  body           String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts    Contract[]

  @@index([organizationId])
  @@map("contract_template")
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  contactId      String
  quoteId        String?
  templateId     String?
  number         String // ex. CTR-2026-0001 (unique par organisation)
  title          String
  status         ContractStatus @default(DRAFT)

  /// Contenu figé du contrat (variables déjà substituées) — c'est ce qui est signé.
  content     String
  publicToken String? @unique // jeton pour la signature côté client

  // Preuves de signature (renseignées à la signature)
  signedAt    DateTime?
  signerName  String?
  signerEmail String?
  signerIp    String?
  /// Empreinte SHA-256 du contenu exact signé.
  contentHash String?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact           @relation(fields: [contactId], references: [id], onDelete: Restrict)
  quote        Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  template     ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  events       SignatureEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@map("contract")
}

model SignatureEvent {
  id             String             @id @default(cuid())
  organizationId String
  contractId     String
  type           SignatureEventType
  actorName      String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId, contractId, createdAt])
  @@map("signature_event")
}

// ---------------------------------------------------------------------------
// Factures, lignes de facture et paiements
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT // brouillon
  SENT // envoyée
  PARTIALLY_PAID // partiellement payée
  PAID // payée
  OVERDUE // en retard
  CANCELED // annulée
}

/// Moyens de paiement (Mobile Money d'Afrique de l'Ouest + classiques).
enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  MTN
  MOOV
  BANK_TRANSFER
  CASH
  OTHER
}

/// Statut d'un paiement. En MVP, la confirmation est MANUELLE (un responsable
/// valide la réception). Aucune confirmation automatique.
enum PaymentStatus {
  PENDING // déclaré, en attente de validation
  CONFIRMED // validé par un responsable
  REJECTED // rejeté
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  contactId      String
  quoteId        String?
  number         String // ex. FAC-2026-0001 (unique par organisation)
  status         InvoiceStatus @default(DRAFT)
  currency       String

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?

  discountType  AmountKind?
  discountValue Int         @default(0)
  depositType   AmountKind?
  depositValue  Int         @default(0)

  // Totaux figés (plus petite unité)
  subtotalMinor Int @default(0)
  discountMinor Int @default(0)
  taxMinor      Int @default(0)
  totalMinor    Int @default(0)
  depositMinor  Int @default(0)
  /// Somme des paiements CONFIRMÉS (rapprochement).
  paidMinor     Int @default(0)

  publicToken String? @unique
  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  quote        Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]
  project      Project?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@map("invoice")
}

model InvoiceItem {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  serviceId      String?
  description    String
  unitPriceMinor Int     @default(0)
  quantity       Int     @default(1)
  taxRate        Int     @default(0)
  position       Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@map("invoice_item")
}

model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  invoiceId        String
  amountMinor      Int
  method           PaymentMethod @default(OTHER)
  reference        String? // référence de transaction (déclarée par le client)
  status           PaymentStatus @default(PENDING)
  /// Vrai si déclaré par le client depuis le portail (vs saisi en interne).
  declaredByClient Boolean       @default(false)
  note             String?

  confirmedById String?
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  confirmedBy  User?        @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([organizationId, invoiceId])
  @@index([organizationId, status])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Projets, étapes et tâches
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNED // planifié
  IN_PROGRESS // en cours
  ON_HOLD // en attente
  IN_REVIEW // en révision
  COMPLETED // terminé
  CANCELED // annulé
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  contactId      String
  quoteId        String?
  invoiceId      String?       @unique // 1 projet max par facture (auto-création idempotente)
  title          String
  description    String?
  status         ProjectStatus @default(PLANNED)
  progress       Int           @default(0) // 0-100, recalculé depuis les tâches

  startDate DateTime?
  dueDate   DateTime?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  quote        Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  stages       ProjectStage[]
  tasks        Task[]

  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@map("project")
}

model ProjectStage {
  id             String @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  position       Int    @default(0)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId, projectId])
  @@map("project_stage")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  stageId        String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  assigneeId     String?
  position       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage        ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@map("task")
}

// ---------------------------------------------------------------------------
// Formulaires publics et soumissions
// ---------------------------------------------------------------------------

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CONSENT
}

model Form {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String  @unique // URL publique /f/[slug]
  description    String?
  active         Boolean @default(true)
  createdById    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  fields       FormField[]
  submissions  FormSubmission[]

  @@index([organizationId])
  @@map("form")
}

model FormField {
  id             String        @id @default(cuid())
  organizationId String
  formId         String
  label          String
  type           FormFieldType @default(TEXT)
  placeholder    String?
  required       Boolean       @default(false)
  options        String[] // pour les listes déroulantes (SELECT)
  position       Int           @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, formId])
  @@map("form_field")
}

model FormSubmission {
  id             String  @id @default(cuid())
  organizationId String
  formId         String
  contactId      String? // prospect créé automatiquement
  data           Json // réponses brutes {label: valeur}
  ipAddress      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, formId, createdAt])
  @@map("form_submission")
}

// ---------------------------------------------------------------------------
// Rendez-vous : types, disponibilités hebdomadaires, réservations
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  CONFIRMED
  CANCELED
}

model AppointmentType {
  id                 String  @id @default(cuid())
  organizationId     String
  name               String
  slug               String  @unique // URL publique /rdv/[slug]
  description        String?
  durationMinutes    Int     @default(30)
  bufferAfterMinutes Int     @default(0)
  minNoticeHours     Int     @default(1)
  active             Boolean @default(true)
  createdById        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation("AppointmentTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  availabilities Availability[]
  appointments   Appointment[]

  @@index([organizationId])
  @@map("appointment_type")
}

model Availability {
  id                String @id @default(cuid())
  organizationId    String
  appointmentTypeId String
  /// Jour de la semaine (0 = dimanche … 6 = samedi).
  dayOfWeek         Int
  /// Minutes depuis minuit (heure locale de l'organisation).
  startMinutes      Int
  endMinutes        Int

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)

  @@index([organizationId, appointmentTypeId])
  @@map("availability")
}

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  appointmentTypeId String
  contactId         String?
  name              String
  email             String
  phone             String?
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(CONFIRMED)
  notes             String?

  createdAt DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, startAt])
  @@index([organizationId, appointmentTypeId, startAt])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Notifications in-app (par utilisateur)
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String // ex. "payment.declared", "quote.accepted"
  title          String
  body           String?
  link           String?
  readAt         DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@map("notification")
}
