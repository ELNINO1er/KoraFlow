# =============================================================================
# Alymero — Modèle de variables d'environnement.
# Copier ce fichier en `.env` puis renseigner les valeurs.
# NE JAMAIS committer de secret réel. Ce fichier ne contient que des exemples.
# =============================================================================

# --- Application ---
# URL publique de l'application (utilisée par l'auth, les liens e-mail, etc.)
APP_URL="http://localhost:3000"

# Code HTML de validation Google Search Console (facultatif, sans la balise meta).
GOOGLE_SITE_VERIFICATION=""
NODE_ENV="development"

# --- Base de données (PostgreSQL) ---
# En dev local via docker compose : port hôte 5433 (voir docker-compose.yml).
DATABASE_URL="postgresql://koraflow:koraflow_dev_password@localhost:5433/koraflow?schema=public"

# --- Authentification (Better Auth) ---
# Générer un secret aléatoire fort, ex. : openssl rand -base64 32
# NE PAS réutiliser cette valeur d'exemple.
BETTER_AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-octets"
BETTER_AUTH_URL="http://localhost:3000"
# Origines de confiance supplémentaires (CSV), ex. IP LAN pour une démo WiFi.
# Optionnel : APP_URL est déjà de confiance. Lu par src/server/auth/auth.ts.
TRUSTED_ORIGINS=""

# --- Internationalisation ---
# NOTE : ces deux variables ne sont PAS lues par l'application (réservées). La
# langue et la devise effectives sont celles de chaque organisation.
DEFAULT_LOCALE="fr"
DEFAULT_CURRENCY="XOF"

# -----------------------------------------------------------------------------
# Les intégrations ci-dessous utilisent des valeurs locales par défaut. En
# production, renseigner les secrets uniquement dans la plateforme d'hébergement.
# -----------------------------------------------------------------------------

# --- E-mail transactionnel ---
# En développement : Mailpit (docker compose) capture les e-mails sans les envoyer.
#   UI web : http://localhost:8025
# En production : renseigner un vrai fournisseur SMTP.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Alymero <no-reply@alymero.test>"

# --- Documents privés ---
# Le pilote local exige un volume persistant en production.
STORAGE_DRIVER="local"
PRIVATE_UPLOAD_DIR=".data/uploads"
# En production managée, utiliser le pilote S3 et renseigner ces cinq valeurs.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Paiement (Sprint 5 — CinetPay, à confirmer) ---
# CINETPAY_API_KEY=""
# CINETPAY_SITE_ID=""
# CINETPAY_WEBHOOK_SECRET=""

# --- Observabilité (Sprint 7) ---
# SENTRY_DSN=""
