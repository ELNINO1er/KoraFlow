# Copier en .env.production sur le serveur. Ne jamais committer ce fichier rempli.
NODE_ENV="production"

# PostgreSQL du service docker-compose.prod.yml
POSTGRES_USER="koraflow"
POSTGRES_PASSWORD="remplacer-par-un-mot-de-passe-long-et-aleatoire"
POSTGRES_DB="koraflow"
DATABASE_URL="postgresql://koraflow:remplacer-par-un-mot-de-passe-long-et-aleatoire@postgres:5432/koraflow?schema=public"

# Domaine HTTPS final
APP_URL="https://koraflow.tech"
BETTER_AUTH_URL="https://koraflow.tech"
BETTER_AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-octets-minimum"

DEFAULT_LOCALE="fr"
DEFAULT_CURRENCY="XOF"

# Fournisseur SMTP réel à choisir avant lancement
SMTP_HOST="smtp.exemple.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="remplacer"
SMTP_PASSWORD="remplacer"
EMAIL_FROM="KoraFlow <no-reply@koraflow.tech>"

# Stockage mono-instance sur volume Docker persistant
STORAGE_DRIVER="local"
PRIVATE_UPLOAD_DIR="/app/uploads"
