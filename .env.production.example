# Copier en .env.production sur le serveur. Ne jamais committer ce fichier rempli.
NODE_ENV="production"

# PostgreSQL du service docker-compose.prod.yml
POSTGRES_USER="alymero"
POSTGRES_PASSWORD="remplacer-par-un-mot-de-passe-long-et-aleatoire"
POSTGRES_DB="alymero"
DATABASE_URL="postgresql://alymero:remplacer-par-un-mot-de-passe-long-et-aleatoire@postgres:5432/alymero?schema=public"

# Domaine HTTPS final
APP_URL="https://alymero.com"
GOOGLE_SITE_VERIFICATION=""
BETTER_AUTH_URL="https://alymero.com"
BETTER_AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-octets-minimum"

# Origines de confiance supplémentaires pour Better Auth (CSV), si un proxy/CDN
# sert l'app depuis un autre hôte. Optionnel : APP_URL est déjà de confiance.
TRUSTED_ORIGINS=""

# NOTE : DEFAULT_LOCALE / DEFAULT_CURRENCY ne sont PAS lus par l'application
# (réservés). La langue et la devise effectives sont celles de chaque
# organisation (réglées à sa création / dans ses paramètres).
DEFAULT_LOCALE="fr"
DEFAULT_CURRENCY="XOF"

# Fournisseur SMTP réel à choisir avant lancement
SMTP_HOST="smtp.exemple.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="remplacer"
SMTP_PASSWORD="remplacer"
EMAIL_FROM="Alymero <no-reply@alymero.com>"

# --- Stockage des documents privés -----------------------------------------
# DEUX stratégies, à choisir selon le mode de déploiement :
#
# (A) Hostinger / hébergement non-Docker / multi-instance → S3 compatible
#     (Supabase Storage, Cloudflare R2, AWS S3). C'est la valeur ci-dessous.
# (B) docker-compose.prod.yml (mono-instance) → le compose FORCE STORAGE_DRIVER
#     =local et PRIVATE_UPLOAD_DIR=/app/uploads (volume persistant). Sur ce
#     chemin, les variables S3_* ci-dessous sont IGNORÉES (voir le compose).
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://project-ref.storage.supabase.co/storage/v1/s3"
S3_REGION="remplacer"
S3_BUCKET="alymero-private"
S3_ACCESS_KEY_ID="remplacer"
S3_SECRET_ACCESS_KEY="remplacer"

# Variante locale (déploiement non-Docker sur disque persistant) :
# STORAGE_DRIVER="local"
# PRIVATE_UPLOAD_DIR="/app/uploads"
